{{ header }}{{ column_left }}
<div id="content" class="bpm-wrap">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="container-fluid">
    <p class="bpm-desc">{{ text_description }}</p>

    <div class="panel panel-default bpm-card">
      <div class="panel-heading"><h3 class="panel-title">{{ text_filter }}</h3></div>
      <div class="panel-body">
        <form class="form-horizontal">
          <div class="form-group">
            <label class="col-sm-2 control-label" for="bpm_categories">{{ text_categories }}</label>
            <div class="col-sm-10">
              <select id="bpm_categories" name="category_ids[]" multiple size="10" class="form-control bpm-select-multi">
                {% for category in categories %}
                  <option value="{{ category.category_id }}">{{ category.name }} ({{ category.product_count }})</option>
                {% endfor %}
              </select>
              <p class="help-block">{{ text_categories_help }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-2 control-label">{{ text_date_range }}</label>
            <div class="col-sm-10">
              <label>{{ text_date_from }}
                <input type="date" id="bpm_date_from" class="form-control bpm-date" style="display:inline-block;width:auto;" />
              </label>
              &nbsp;
              <label>{{ text_date_to }}
                <input type="date" id="bpm_date_to" class="form-control bpm-date" style="display:inline-block;width:auto;" />
              </label>
              <p class="help-block">{{ text_date_help }}</p>
            </div>
          </div>
          <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10">
              <button type="button" class="btn btn-default" id="bpm_preview_btn">{{ button_preview }}</button>
              <span id="bpm_preview_result" class="bpm-preview-result"></span>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div class="panel panel-default bpm-card">
      <div class="panel-heading"><h3 class="panel-title">{{ text_outofstock }}</h3></div>
      <div class="panel-body">
        <p>{{ text_outofstock_help }}</p>
        <button type="button" class="btn btn-primary" id="bpm_stock_btn" disabled>{{ button_outofstock }}</button>
      </div>
    </div>

    <div class="panel panel-default bpm-card">
      <div class="panel-heading"><h3 class="panel-title">{{ text_instock_sku }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_instock_help }}</p>
        <div class="form-group">
          <label class="col-sm-2 control-label" for="bpm_sku_file">{{ text_sku_file }}</label>
          <div class="col-sm-10">
            <input type="file" id="bpm_sku_file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
          </div>
        </div>
        <div class="form-group">
          <div class="col-sm-offset-2 col-sm-10">
            <button type="button" class="btn btn-primary" id="bpm_instock_btn">{{ button_instock }}</button>
            <span id="bpm_sku_file_result" class="bpm-preview-result"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default bpm-card">
      <div class="panel-heading"><h3 class="panel-title">{{ text_sort_sku }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_sort_help }}</p>
        <div class="form-group">
          <label class="col-sm-2 control-label" for="bpm_sort_file">{{ text_sku_file }}</label>
          <div class="col-sm-10">
            <input type="file" id="bpm_sort_file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
          </div>
        </div>
        <div class="form-group">
          <label class="col-sm-2 control-label" for="bpm_sort_order_value">{{ text_sort_order }}</label>
          <div class="col-sm-10">
            <input type="number" id="bpm_sort_order_value" class="form-control" style="width:120px;" step="1" value="0" />
          </div>
        </div>
        <div class="form-group">
          <div class="col-sm-offset-2 col-sm-10">
            <button type="button" class="btn btn-primary" id="bpm_sort_btn">{{ button_sort }}</button>
            <span id="bpm_sort_result" class="bpm-preview-result"></span>
          </div>
        </div>
      </div>
    </div>

    <div class="panel panel-default bpm-card">
      <div class="panel-heading"><h3 class="panel-title">{{ text_prices }}</h3></div>
      <div class="panel-body">
        <p class="help-block">{{ text_prices_help }}</p>
        <table class="table table-bordered table-striped bpm-price-table">
          <thead>
            <tr>
              <th>{{ text_size }}</th>
              <th>{{ text_regular }}</th>
              <th>{{ text_special }}</th>
            </tr>
          </thead>
          <tbody>
            {% for key, label in size_labels %}
              <tr>
                <td><strong>{{ label }}</strong></td>
                <td>
                  <input type="number" min="0" step="0.01" class="form-control bpm-price-input" data-type="regular" data-size="{{ key }}" placeholder="{{ text_placeholder }}" />
                </td>
                <td>
                  <input type="number" min="0" step="0.01" class="form-control bpm-price-input" data-type="sale" data-size="{{ key }}" placeholder="{{ text_placeholder }}" />
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <p class="bpm-price-actions">
          <button type="button" class="btn btn-default" id="bpm_fill_demo">{{ button_fill_demo }}</button>
          <button type="button" class="btn btn-default" id="bpm_clear_prices">{{ button_clear_prices }}</button>
          <button type="button" class="btn btn-primary" id="bpm_price_btn" disabled>{{ button_prices }}</button>
        </p>
      </div>
    </div>

    <div class="panel panel-default bpm-card bpm-progress-card" id="bpm_progress_card" style="display:none;">
      <div class="panel-heading"><h3 class="panel-title">{{ text_progress }}</h3></div>
      <div class="panel-body">
        <div class="bpm-progress-bar-bg">
          <div class="bpm-progress-bar" id="bpm_progress_bar"></div>
        </div>
        <div class="bpm-stats">
          <div class="bpm-stat">
            <span class="bpm-stat-label">{{ text_stat_total }}</span>
            <span class="bpm-stat-num" id="bpm_stat_total">0</span>
          </div>
          <div class="bpm-stat">
            <span class="bpm-stat-label">{{ text_stat_ok }}</span>
            <span class="bpm-stat-num bpm-ok" id="bpm_stat_ok">0</span>
          </div>
          <div class="bpm-stat">
            <span class="bpm-stat-label">{{ text_stat_fail }}</span>
            <span class="bpm-stat-num bpm-fail" id="bpm_stat_fail">0</span>
          </div>
          <div class="bpm-stat">
            <span class="bpm-stat-label">{{ text_stat_pct }}</span>
            <span class="bpm-stat-num" id="bpm_stat_pct">0%</span>
          </div>
        </div>
        <div class="bpm-console" id="bpm_console"></div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript">
window.bpmAdmin = {{ bpm_admin_json|raw }};
</script>
<script type="text/javascript" src="view/javascript/bulk_product_manager.js?v=1.0.1"></script>
{{ footer }}
