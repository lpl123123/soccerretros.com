{{ header }}{{ column_left }}{{ seoloadstyles }}
<section class="sticky-header sticky-header235">
        <!-- sidebar left start-->
        {{ seomenu }}
        <!-- sidebar left end-->

        <!-- body content start-->
        <div class="body-content" >
            <!-- header section start-->
            <div class="header-section">

                <!--logo and logo icon start-->
                <div class="icon-logo dark-logo-bg hidden-xs hidden-sm">
                    <a href="index.html">
                        <img src="view/javascript/aios/img/logo-icon.png" alt="">
                        <!--<i class="fa fa-maxcdn"></i>-->
                    </a>
                </div>
                <!--logo and logo icon end-->

                <!--toggle button start-->
                <a class="toggle-btn"><i class="fa fa-outdent"></i></a>
                <!--toggle button end-->

                <!--mega menu start-->
               {{ seomegamenu }}
                <!--mega menu end-->

                <div class="notification-wrap">
                <!--left notification start-->
                <div class="left-notification">
                <ul class="notification-menu">

                <!--task info start-->
                {{ seotask }}
                <!--task info end-->

                 <!--notification info start-->
                {{ seonotification }}
                <!--notification info end-->
               
                </ul>
                </div>
                <!--left notification end-->
                
                </div>

            </div>
            <!-- header section end-->

            <!--body wrapper start-->
          <div class="wrapper">
            <div class="page-head">
                <h3>
                    {{ tab_general }}
                </h3>
                <span class="sub-title">{{ tab_general_help }}</span>
            </div>
            <br>
            <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-general" class="form-horizontal">
        <div id="tab_general">
            <div class="row">
                    <div class="col-sm-6">
                        &nbsp;
                    </div>
                    <div class="col-sm-4">
                        {% for language in languages %}
                        <div class="buttons button_tabs">
                            <a value="custom_url_store_language{{ language.language_id }}" class="btn btn-primary custom_url_store_language_button" onclick="showLang('custom_url_store_language{{ language.language_id }}','custom_url_store_language');" title="{{ language.name }}"><span>
                             <img src="language/{{ language.code }}/{{ language.code }}.png" title="{{ language.name }}" />
                            </span></a>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="col-sm-2">
                        <div class="pull-right">
                           <button type="submit"  form="form-general" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
                       </div>
                    </div>
             </div>
             {% if success %}
                <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
                  <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
            {% endif %}
              {% if error_warning %}
  <div class="alert alert-warning"><i class="fa fa-check-circle"></i> {{ error_warning }}
                  <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
  {% endif %}  
  {% if error_already_exists %}
  <div class="alert alert-warning"><i class="fa fa-check-circle"></i> {{ error_already_exists }}
                  <button type="button" class="close" data-dismiss="alert">&times;</button>
                </div>
  {% endif %}
            <div class="clear" style="margin-top: 25px;"></div>
            <table id="custom_url_store" class="pure-table pure-table-bordered" style="width:100%;">
                <thead>
                    <tr>
                        <td class="left">{{ column_url }}</td>
                        <td class="left">{{ column_keyword }}</td>
                        <td class="center brt">{{ column_title }}<a class="help_icon" title="{{ title_help  }}"></a></td>
                        <td class="center brt">{{ column_meta_keyword }}<a class="help_icon" title="{{ keywords_help  }}"></a></td>
                        <td class="center">{{ column_meta_description }}<a class="help_icon" title="{{ description_help  }}"></a></td>
                        <td align="center">{{ "Action" }}</td>
                    </tr>
                </thead>    
                {% set custom_url_store_row = 0 %}
                {% for key,value in custom_url_store_data %}   
                    <tbody id="custom_url_store_row{{ custom_url_store_row }}">
                        <tr>   <td>{{ domain }}index.php?route=<input class="blueprint" type="text" size="16" name="custom_url_store[{{ custom_url_store_row }}][query]" value="{{ value.id }}" /></td>
                                {% for row,custom_url_store_top in value %}
                                    {% if row is defined and row == 'keyword' %}
                                         <td>
                                         {% for language in languages %}
                                        {{ domain }}<input size="30"  type="text" class="custom_url_store_language{{ language.language_id }} ct form-control" name="custom_url_store[{{ custom_url_store_row }}][keyword][{{ language.language_id }}]" value="{{ custom_url_store_top.language_id[language.language_id] }}" class="form-control" />
                                         {% endfor %}
                                         </td>
                                    {% endif %}
                                    {% if row is defined and row == 'custom_url_store_description' %}
                                        <td class="brt center">
                                            {% for language in languages %}
                                                <textarea class="custom_url_store_language{{ language.language_id }} ct" name="custom_url_store[{{ custom_url_store_row }}][custom_url_store_description][{{ language.language_id }}][name]" cols="16" rows="6">{{ value[row][language.language_id] ? value[row][language.language_id].name  }}</textarea>
                                                <span class="custom_url_store_language{{ language.language_id }} countt">-</span>
                                            {% endfor %}
                                        </td>
                                        <td class="brt center">
                                            {% for language in languages %}
                                                <textarea class="custom_url_store_language{{ language.language_id }} ck" name="custom_url_store[{{ custom_url_store_row }}][custom_url_store_description][{{ language.language_id }}][meta_keywords]" cols="16" rows="6">{{ value[row][language.language_id] ? value[row][language.language_id].meta_keywords  }}</textarea>
                                                <span class="custom_url_store_language{{ language.language_id }} countk">-</span>
                                            {% endfor %}
                                        </td>
                                        <td class="center">
                                            {% for language in languages %}
                                                <textarea class="custom_url_store_language{{ language.language_id }} cc" name="custom_url_store[{{ custom_url_store_row }}][custom_url_store_description][{{ language.language_id }}][meta_description]" cols="16" rows="6">{{ value[row][language.language_id] ? value[row][language.language_id].meta_description  }}</textarea>
                                                <span class="custom_url_store_language{{ language.language_id }} count">-</span>
                                            {% endfor %}
                                        </td>
                                    {% endif %}
                                {% endfor %}
                            <td align="center"><a style="text-decoration: none;"  onclick="$('#custom_url_store_row{{ custom_url_store_row }}').remove();" class="btn btn-danger"><span>{{ button_remove }}</span></a></td>
                        </tr>
                    </tbody>
                 {% set custom_url_store_row = custom_url_store_row + 1  %}
                {% endfor %}
                <tfoot>
                    <tr>
                        <td width="90%" colspan="5">&nbsp;</td>
                        <td width="10%" align="center"><a style="text-decoration: none;" onclick="addcustom_url_store();" class="btn btn-primary"><span><i class="fa fa-plus"></i>  {{ button_add_custom_url_store }}</span></a></td>
                    </tr>
                </tfoot>              
            </table>
        </div>
    </form>
        </div>
        <!--body wrapper end-->


        <!--footer section start-->
        <footer>
            1616 &copy; ALL IN ONE SEO by NERDHERD
        </footer>
        <!--footer section end--> 

        </div>
        <!-- body content end-->
    </section>
{{ footer }}
<!--jquery-ui-->

<script type="text/javascript"><!--
var custom_url_store_row = {{ custom_url_store_row }};
var currency = "{{ currency }}";
var edited = false;
function addcustom_url_store() {
    html  = '<tbody id="custom_url_store_row' + custom_url_store_row + '">';
    html += '<tr>'; 
    html += '<td class="left">{{ domain }}index.php?route=<input type="text" size="16" name="custom_url_store.+custom_url_store_row+[query]" value="" /></td>';
   html += '<td class="left">';
    {% for language in languages %}
    var language_id = "{{ language.language_id }}";
     html += '{{ domain }}<input type="text" size="30" class="custom_url_store_language'+language_id+'"  name="custom_url_store.+custom_url_store_row+[keyword].+language_id+" value="" />';
    {% endfor %}
    html += '</td><td class="brt center">'
     {% for language in languages %}
    var language_id = "{{ language.language_id }}";
    html += '<textarea class="custom_url_store_language'+language_id+'" name="custom_url_store.+custom_url_store_row+[custom_url_store_description].+language_id+[name]" cols="16" rows="6"></textarea>';
    {% endfor %}
    html += '</td>';
    html += '<td class="brt center">';
    {% for language in languages %}
        var language_id = "{{ language.language_id }}";
        html += '<textarea class="custom_url_store_language'+language_id+'" name="custom_url_store.+custom_url_store_row+[custom_url_store_description].+language_id+[meta_keywords]" cols="16" rows="6"></textarea>';
    {% endfor %}
    html += '</td>';
    html += '<td class="center">';
    {% for language in languages %}
        var language_id = "{{ language.language_id }}";
        html += '<textarea class="custom_url_store_language'+language_id+'" name="custom_url_store.+custom_url_store_row+[custom_url_store_description].+language_id+[meta_description]" cols="16" rows="6"></textarea>';
    {% endfor %}
    html += '</td>';
    html += '<td align="center"><a style="text-decoration: none;" onclick="$(\'#custom_url_store_row' + custom_url_store_row + '\').remove();" class="btn btn-danger"><span>{{ button_remove }}</span></a></td>';
    html += '</tr>';
    html += '</tbody>';
    
    $('#custom_url_store tfoot').before(html);
    
    custom_url_store_row++;
    showLang('custom_url_store_language'+currency,'custom_url_store_language');
}

function showLang(selected,button){
    $('.'+selected).siblings().hide();
    $('.'+selected).show();
    $('.button_tabs .'+button+'_button').css('opacity','1');
    $('.button_tabs a[value="'+selected+'"]').css('opacity','0.5');
}

showLang('custom_url_store_language'+currency,'custom_url_store_language');

$(document).ready(function() {
    $("input, textarea").keypress(function() {
        edited = true;
    });
    $("form").submit(function(e) {
        edited = false;
    });

    $(".count").each(function() {
        var l = $(this).prev().val().length;
        if(l == 0){
            $(this).html('✘');
        } else {
            $(this).html('✔');
        }
    });
    $(".countk").each(function() {
        var l = $(this).prev().val().length;
        if(l == 0){
            $(this).html('✘');
        } else {
            $(this).html('✔');
        }
    });

    $(".countt").each(function() {
        var l = $(this).prev().val().length;
        if(l == 0){
            $(this).html('✘');
        } else {
            $(this).html('✔');
        }
    });

    $(".countta").each(function() {
        var l = $(this).prev().val().length;
        if(l == 0){
            $(this).html('✘');
        } else {
            $(this).html('✔');
        }
    });

    
});

$(function(){
    $(".help_icon").tipTip({
        maxWidth: "275px", 
        defaultPosition: "top",
        delay: 100
    });
});

{% if existing_keyword is defined and existing_keyword %}
    var existing_keyword = "{{ existing_keyword }}";
    var selector = $('input[value*="'+existing_keyword+'"]');
    var trimmed;
    $(selector).each(function() {
        trimmed = $.trim($(this).val());
        if(trimmed == existing_keyword){
            $(this).addClass('existing_keyword');
        }
    });
    $(selector).keyup(function() {
        $(this).removeClass('existing_keyword');
    });
{% endif %}

//--></script>

