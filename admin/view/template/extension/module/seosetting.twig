{{ header }}{{ column_left }}{{ seoloadstyles }}
<section class="sticky-header sticky-header235">
        <!-- sidebar left start-->
        {{ seomenu }}
        <!-- sidebar left end-->

        <!-- body content start-->
        <div class="body-content" >
            <!-- header section start-->
            <div class="header-section">

                <!--logo and logo icon start-->
                <div class="icon-logo dark-logo-bg hidden-xs hidden-sm">
                    <a href="index.html">
                        <img src="view/javascript/aios/img/logo-icon.png" alt="">
                        <!--<i class="fa fa-maxcdn"></i>-->
                    </a>
                </div>
                <!--logo and logo icon end-->

                <!--toggle button start-->
                <a class="toggle-btn"><i class="fa fa-outdent"></i></a>
                <!--toggle button end-->

                <!--mega menu start-->
               {{ seomegamenu }}
                <!--mega menu end-->

                <div class="notification-wrap">
                <!--left notification start-->
                <div class="left-notification">
                <ul class="notification-menu">

                <!--task info start-->
                {{ seotask }}
                <!--task info end-->

                 <!--notification info start-->
                {{ seonotification }}
                <!--notification info end-->
               
                </ul>
                </div>
                <!--left notification end-->
                
                </div>

            </div>
            <!-- header section end-->

            <!--body wrapper start-->
             <div class="wrapper">
          <form action="{{ action }}" id="form" method="post" enctype="multipart/form-data" class="form-horizontal"> 
                  <div class="container-fluid">
                      <div class="pull-right">
                             <button onclick="$('#form').submit();" form="form" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i> Save</button>
                         </div>
                  </div>
                   <table class="table table-striped">
                            <thead>
                            <tr>
                                <th>Setting Name</th>
                                <th>Description</th>
                                <th>Action</th>
                            </tr>
                            </thead>
                             <tbody>
                            <tr>
                                <td>{{ text_self_generate }}</td>
                                <td>{{ help_self_generate }}</td>
                                <td>
                                  <div class="onoffswitch">
                                      <input type="checkbox" name="module_aioseo_self_generate" class="onoffswitch-checkbox module_aioseo_self_generate" id="myonoffswitch2"  {% if module_aioseo_self_generate %} {{ "checked" }} {% endif %} >
                                  </div>
                                </td>
                            </tr>

                            <tr>
                                <td>{{ text_direct_links }}</td>
                                <td>{{ help_direct_links }}</td>
                                <td>
                                 <div class="onoffswitch">
                                    <input type="checkbox" name="module_aioseo_direct_links" class="onoffswitch-checkbox module_aioseo_direct_links" id="myonoffswitch3"  {% if module_aioseo_direct_links %} {{ "checked" }} {% endif %} >
                                </div>
                                </td>
                            </tr>

                            <tr>
                                <td>{{ text_multi_lang }}</td>
                                <td>{{ help_multi_lang }}</td>
                                <td>
                                 <div class="onoffswitch">
                                    <input type="checkbox" name="module_aioseo_breadcrumblink" class="onoffswitch-checkbox module_aioseo_breadcrumblink" id="myonoffswitch1" {% if module_aioseo_breadcrumblink%} {{ "checked" }} {% endif %} >
                                  </div>
                                </td>
                            </tr>

                            <tr>
                                <td>{{ text_manufacturer_breadcrumb }}</td>
                                <td>{{ help_manufacturer_breadcrumb }}</td>
                                <td>
                                 <div class="onoffswitch">
                                    <input type="checkbox" name="module_aioseo_manu_breadcrumblink" class="onoffswitch-checkbox module_aioseo_manu_breadcrumblink" id="myonoffswitch4" {% if module_aioseo_manu_breadcrumblink%} {{ "checked" }} {% endif %} >
                                  </div>
                                </td>
                            </tr>

                      </tbody>
                  </table>
              </form>
          </div>
      </div>
    </div>
  </div>
  <div id="myModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h1 class="modal-title">How to generate seo automatically?</h1>
            </div>
            <div class="modal-body">
               {{ text_about }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
{{ footer }}
{{ seoloadscripts }}