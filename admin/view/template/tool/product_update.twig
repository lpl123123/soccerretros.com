{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>产品批量更新 (XLSX)</h1>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-body">
        <div id="upload-section" class="text-center" style="padding: 40px; border: 2px dashed #ddd;">
            <i class="fa fa-refresh fa-4x" style="color: #e67e22; margin-bottom: 15px;"></i>
            <p>上传从“导出功能”导出的 XLSX 文件进行更新（以 Id/SKU 为准）</p>
            <input type="file" id="input-file" class="hidden" accept=".xlsx" />
            <button type="button" class="btn btn-default" onclick="$('#input-file').click();">选择 XLSX 文件</button>
            <button type="button" id="button-upload" class="btn btn-warning btn-lg" style="margin-top: 15px; display: block; width: 100%;">开始批量更新</button>
        </div>

        <div id="progress-section" style="display:none; margin-top:20px;">
            <div class="progress" style="height: 30px; border-radius: 15px;">
                <div id="progress-bar" class="progress-bar progress-bar-warning progress-bar-striped active" role="progressbar" style="width: 0%; line-height: 30px;">0%</div>
            </div>
            <div id="countdown-text" class="text-center" style="color: #e67e22; font-weight: bold; margin-bottom: 10px;"></div>
            <div id="progress-text" class="text-center" style="font-size: 16px; margin-bottom: 20px;">正在准备...</div>
            <div class="well" id="log-container" style="background: #222; color: #0f0; font-family: monospace; height: 300px; overflow-y: scroll;">
                <div id="log"></div>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
var totalRows = 0; var currentRow = 0; var filePath = ''; var waitTime = 5000;

$('#button-upload').on('click', function() {
    if (!$('#input-file')[0].files[0]) { alert("请先选择文件"); return; }
    var formData = new FormData();
    formData.append('file', $('#input-file')[0].files[0]);
    $.ajax({
        url: 'index.php?route=tool/product_update/upload&user_token={{ user_token }}',
        type: 'POST',
        data: formData,
        processData: false, contentType: false, dataType: 'json',
        success: function(json) {
            if (json['error']) { alert(json['error']); } 
            else {
                totalRows = json['total']; filePath = json['file_path'];
                $('#upload-section').hide(); $('#progress-section').show();
                processNextRow();
            }
        }
    });
});

function processNextRow() {
    if (currentRow >= totalRows) {
        $('#progress-bar').removeClass('active');
        $('#progress-text').html('<span class="text-success">🎉 全部产品更新完成！</span>');
        return;
    }
    var timeLeft = waitTime / 1000;
    var timer = setInterval(function() {
        $('#countdown-text').html('等待中... ' + timeLeft + 's');
        timeLeft--;
        if (timeLeft < 0) { clearInterval(timer); executeUpdate(); }
    }, 1000);
}

function executeUpdate() {
    $('#countdown-text').html('正在更新第 ' + (currentRow + 1) + ' 条...');
    $.ajax({
        url: 'index.php?route=tool/product_update/updateRow&user_token={{ user_token }}',
        type: 'POST',
        data: { file_path: filePath, row_index: currentRow },
        dataType: 'json',
        success: function(json) {
            currentRow++;
            var percent = Math.round((currentRow / totalRows) * 100);
            $('#progress-bar').css('width', percent + '%').text(percent + '%');
            $('#progress-text').text('处理中: ' + currentRow + ' / ' + totalRows);
            if (json['success']) {
                $('#log').append('<div>[' + new Date().toLocaleTimeString() + '] ' + json['msg'] + ' <span style="color:#0f0;">[OK]</span></div>');
            } else {
                $('#log').append('<div style="color:#f39c12;">[' + new Date().toLocaleTimeString() + '] ' + json['error'] + '</div>');
            }
            $("#log-container").scrollTop($("#log-container")[0].scrollHeight);
            processNextRow();
        }
    });
}
//--></script>
{{ footer }}