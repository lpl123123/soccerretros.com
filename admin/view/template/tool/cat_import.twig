{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <h1>分类批量更新</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-refresh"></i> 上传 XLSX 更新分类</h3>
      </div>
      <div class="panel-body">
        <div id="upload-section" style="padding: 30px; text-align: center; border: 2px dashed #eee;">
            <i class="fa fa-file-excel-o fa-4x" style="color: #3498db; margin-bottom: 15px;"></i>
            <p>请上传由“分类导出”功能生成的 .xlsx 文件</p>
            <input type="file" id="input-file" class="hidden" accept=".xlsx" onchange="$('#file-name').text(this.files[0].name);" />
            <button type="button" class="btn btn-default" onclick="$('#input-file').click();">选择文件</button>
            <div id="file-name" style="margin: 10px 0; font-weight: bold;"></div>
            <button type="button" id="button-upload" class="btn btn-primary btn-lg">开始更新</button>
        </div>

        <div id="progress-section" style="display:none; margin-top:20px;">
            <div class="progress" style="height: 25px;">
                <div id="progress-bar" class="progress-bar progress-bar-success progress-bar-striped active" style="width: 0%; line-height: 25px;">0%</div>
            </div>
            <div id="progress-text" class="text-center" style="font-weight: bold; margin-bottom: 10px;"></div>
            <div class="well" id="log-container" style="background: #222; color: #0f0; font-family: monospace; height: 250px; overflow-y: scroll; padding: 15px;">
                <div id="log"></div>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="text/javascript"><!--
var totalRows = 0;
var currentRow = 0;
var filePath = '';

$('#button-upload').on('click', function() {
    if (!$('#input-file')[0].files[0]) { alert("请选择文件"); return; }
    
    var formData = new FormData();
    formData.append('file', $('#input-file')[0].files[0]);

    $.ajax({
        url: 'index.php?route=tool/cat_import/upload&user_token={{ user_token }}',
        type: 'POST',
        data: formData,
        processData: false,
        contentType: false,
        dataType: 'json',
        beforeSend: function() { $('#button-upload').prop('disabled', true); },
        success: function(json) {
            if (json['error']) {
                alert(json['error']);
                $('#button-upload').prop('disabled', false);
            } else {
                totalRows = json['total'];
                filePath = json['file_path'];
                $('#upload-section').hide();
                $('#progress-section').show();
                processNextRow();
            }
        }
    });
});

function processNextRow() {
    if (currentRow >= totalRows) {
        $('#progress-bar').removeClass('active');
        $('#progress-text').html('<span class="text-success">所有分类更新完成！</span>');
        return;
    }

    $.ajax({
        url: 'index.php?route=tool/cat_import/importRow&user_token={{ user_token }}',
        type: 'POST',
        data: { file_path: filePath, row_index: currentRow },
        dataType: 'json',
        success: function(json) {
            currentRow++;
            var percent = Math.round((currentRow / totalRows) * 100);
            $('#progress-bar').css('width', percent + '%').text(percent + '%');
            $('#progress-text').text('正在处理: ' + currentRow + ' / ' + totalRows);
            
            if (json['success']) {
                $('#log').append('<div>[' + currentRow + '] ' + json['msg'] + '</div>');
            } else {
                $('#log').append('<div style="color: #f39c12;">[' + currentRow + '] ' + (json['error'] || '未知错误') + '</div>');
            }
            $("#log-container").scrollTop($("#log-container")[0].scrollHeight);
            
            // 分类更新通常很快，设置 500ms 间隔即可，不需要像产品那样等 5s
            setTimeout(processNextRow, 500); 
        }
    });
}
//--></script>
{{ footer }}