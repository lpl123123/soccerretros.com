          array (
            'product_id' => '1449',
            'name' => 'Tigres UANL Mens 65th Anniversary Retro Soccer Jersey Gold',
            'description' => '<p>Celebrate 65 years of fierce football with the Tigres UANL Anniversary Jersey. This special edition kit leaps back into the club\'s history with a classic collegiate gold colorway and vintage club badge. Featuring a repeating retro pattern and a sophisticated polo collar, this shirt is a true blast from the past for every dedicated fan.</p><ul><li>65th Anniversary special edition commemorative design</li><li>Classic collegiate gold with retro repeating pattern</li><li>Vintage Tigres UANL club crest</li><li>Sophisticated polo collar and regular fit</li><li>Breathable, high-quality performance fabric</li></ul>',
